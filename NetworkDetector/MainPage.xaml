<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NetworkDetector.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label 
                Text="Network Status Monitor"
                HorizontalOptions="Center" />

            <Image 
                x:Name="StatusImage"
                HeightRequest="150"
                WidthRequest="150"
                HorizontalOptions="Center" />

            <Label 
                x:Name="StatusLabel"
                HorizontalOptions="Center" />
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
